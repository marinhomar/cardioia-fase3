  {
    "id": "fn_status",
    "type": "function",
    "z": "tab_cardioia",
    "name": "Formatar status",
    "func": "const s = msg.payload || {};\nmsg.payload = `${s.estado || '?'} | buffer ${s.buffer ?? '-'} / ${s.capacidade ?? '-'} | perdidas ${s.perdidas ?? 0}`;\nreturn msg;",
