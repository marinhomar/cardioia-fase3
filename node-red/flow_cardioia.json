  {
    "id": "fn_separar",
    "type": "function",
    "z": "tab_cardioia",
    "name": "Separar sinais e checar limites",
    "func": "// Recebe uma leitura do ESP32 e distribui para cada widget do painel.\n// Limites do projeto: febre > 38 °C, taquicardia > 120 bpm, bradicardia < 50 bpm (com pulso).\nconst d = msg.payload;\nif (typeof d !== 'object' || d === null) return null;\n\nconst temp = Number(d.temp);\nconst bpm  = Number(d.bpm);\n\nlet alerta = [];\nif (temp > 38) alerta.push('FEBRE');\nif (bpm > 120) alerta.push('TAQUICARDIA');\nif (bpm > 0 && bpm < 50) alerta.push('BRADICARDIA');\nconst emAlerta = alerta.length > 0;\n\n// Leitura que ficou guardada offline chega com atraso_s > 0\nconst origem = d.atraso_s > 5 ? ` (veio do buffer, medida há ${d.atraso_s}s)` : '';\n\nconst msgBpm   = { topic: 'BPM', payload: bpm };\nconst msgTemp  = { topic: 'Temperatura (°C)', payload: temp };\nconst msgGauge = { payload: temp };\nconst msgAlerta = {\n    payload: emAlerta\n        ? `<b style=\"color:#e53935\">⚠ ${alerta.join(' + ')}</b> — leitura #${d.seq}${origem}`\n        : `<span style=\"color:#43a047\">● Normal</span> — leitura #${d.seq}${origem}`\n};\nconst msgLed = { payload: emAlerta };\n\nreturn [msgBpm, msgTemp, msgGauge, msgAlerta, msgLed];",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 120,
    "wires": [
      [
        "chart_sinais"
      ],
      [
        "chart_sinais"
      ],
      [
        "gauge_temp"
      ],
      [
        "txt_alerta"
      ],
      [
        "tpl_led"
      ]
    ]
  },
